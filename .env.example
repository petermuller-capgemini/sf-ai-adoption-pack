# sf-ai-pack preset configuration
# Copy to .sf-ai-pack.env in your Salesforce DX project root, or pass
# --env-file <path> to point at a file elsewhere.
#
# Precedence: CLI argument > --env-file > project .sf-ai-pack.env > built-in defaults

# Which assets to install: github | claude | both
TARGET=both

# How to handle files that already exist: skip | overwrite | backup | fail
MERGE_STRATEGY=skip

# --- Project identity -------------------------------------------------------
PROJECT_NAME="My Salesforce Project"
PROJECT_DESCRIPTION="Salesforce DX project for Acme Corp"
TEAM_NAME="Acme Platform Team"

# --- Naming conventions ------------------------------------------------------
APEX_PREFIX=ACM
LWC_PREFIX=acm
FLOW_PREFIX=ACM
SUBFLOW_PREFIX=ACM_Sub
CONFIG_PREFIX=ACM

# --- Shared utility class names ----------------------------------------------
LOGGER_CLASS=ACM_Logger
LOGGER_FACTORY=ACM_LoggerFactory
TEST_DATA_FACTORY=ACM_TestDataFactory
UTILITY_CONTROLLER=ACM_UtilityController
DEFAULT_PSG=ACM_Standard_User

# --- Quality gates ------------------------------------------------------------
MIN_COVERAGE=75
TARGET_COVERAGE=90
SF_API_VERSION=62.0

# --- Platform context ----------------------------------------------------------
SALESFORCE_CLOUDS="Sales Cloud, Experience Cloud"
EXTERNAL_INTEGRATIONS="Payment Gateway, ERP"
CICD_TOOL="GitHub Actions"
WORK_ITEM_TOOL="GitHub Issues"
